
<link rel="stylesheet" href="/css/product.css">

<header class="topbar">

            <div class="breadcrumb">
                <span>⌂</span>
                <span>›</span>
                <strong>Product</strong>
            </div>

            <div class="top-actions">

                <button class="premium" href="add" >♢ Premium account</button>

                <button class="top-icon">◴</button>
                <button class="top-icon">▣</button>
                <button class="top-icon">⚙</button>

            </div>

        </header>


        <!-- PAGE HEADING -->
        <div class="page-heading">

            <div>
                <h1>Product List</h1>
                <p>Real-time insights on sales performance and stock status</p>
            </div>

            <div class="page-tools">

                <div class="search-box">
                    <span>⌕</span>
                    <input type="text" placeholder="Search">
                    <small>⌘ F</small>
                </div>

                <select>
                    <option>Last month</option>
                    <option>Last week</option>
                    <option>Today</option>
                    <option>This year</option>
                </select>

            </div>

        </div>


        <!-- ANALYTICS SECTION -->
        <section class="analytics-grid">

            <!-- PRODUCTS BREAKDOWN -->
            <div class="analytics-card breakdown">

                <div class="card-title">
                    <span class="card-icon">⬡</span>
                    <h3>Products Breakdown</h3>
                </div>

               

                <div class="warehouse">

                    <div class="warehouse-info">

                        <div>
                            <strong id="texttotl">37.362</strong>
                            <small>(Total Items In Warehouse)</small>
                        </div>

                        <span id="progressText">75% used of 100% capacity</span>

                    </div>

                    <div class="progress">
                        <div class="progress-fill" id="progress-fill"></div>
                    </div>

                </div>

            </div>


            <!-- REJECTION ITEMS -->
            

        </section>


        <!-- SALES RECAP -->
        <section class="sales-card">

            <div class="sales-header">

                <h3>
                    <span>🛒</span>
                    Sales Recap
                </h3>

                <div class="sales-actions">

                    <button title="Download">⇩</button>
                    <button title="Sort">☷</button>

                    <select>
                        <option>Filter</option>
                        <option>Electronics</option>
                        <option>Home Living</option>
                    </select>

                </div>

            </div>


            <!-- PRODUCT TABLE -->
            <div class="table-wrapper">

                <table>

                    <thead>
                        <tr>
                            <th>Product</th>
                            <th>ID</th>
                            <th>Brand</th>
                            <th>Qty</th>
                            <th>Fix Price</th>
                            <th>Update</th>
                            <th></th>
                        </tr>
                    </thead>

                    <tbody>
                        <% products.forEach((product) => {%> 
                        <tr>
                            

                            <td>
                                <div class="product-name">
                                    <img src="<%= product.imageUrl[0]%>" alt="Product">
                                    <div>
                                        <strong><%= product.name%></strong>
                                        <small><%= product.category%></small>
                                    </div>
                                </div>
                            </td>

                            <td><b><%= product.sku%></b></td>
                            <td><%= product.brand%></td>
                            <td><%= product.stock%></td>
                            <td class="price">$<%= product.price%></td>
                            <td class="update"><a href="/productsshow/update/<%= product._id %>">UPDATE</a></td>
                            <td class="more"><a href="/productsshow/<%= product._id %>">•••</a></td>
                        </tr>
                        <% }) %>


                        

                    </tbody>

                </table>

            </div>

        </section>
         <script src="/JS/progress.js"></script>