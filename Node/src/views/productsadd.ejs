<link rel="stylesheet" href="/css/pro-add.css">


        <!-- PAGE TITLE -->
        <div class="page-heading">
            <h1>Add New Product</h1>
            <p>Add a new product to your store</p>
        </div>


        <!-- PRODUCT FORM -->
        <form class="product-form">

            <div class="form-left">

                <!-- NAME AND DESCRIPTION -->
                <section class="card">
                    <div class="card-heading">
                        <h3>Name and Description</h3>
                    </div>

                    <div class="card-body">

                        <div class="form-group">
                            <label>Product Name</label>
                            <input type="text"
                                value="Premium Half Sleeve T-Shirt - Brooklyn Fleece">
                        </div>

                        <div class="form-group">
                            <label>Product Description</label>

                            <div class="editor">
                                <textarea>Looking for a little extra warmth? Grab this classic hoodie. Smooth on the outside with unbrushed loops on the inside, our mid weight French terry is comfortable enough to wear year long.

Product Details
• Body: 80% cotton/20% polyester. Hood lining: 100% cotton.
• Colour Shown: Black/White
• Style: FV7283-010</textarea>

                                <div class="editor-toolbar">
                                    <button type="button"><b>B</b></button>
                                    <button type="button"><i>I</i></button>
                                    <button type="button"><u>U</u></button>
                                    <button type="button">⌁</button>
                                    <button type="button">☷</button>
                                </div>
                            </div>
                        </div>

                    </div>
                </section>


                <!-- CATEGORY -->
                <section class="card">
                    <div class="card-heading">
                        <h3>Category</h3>
                    </div>

                    <div class="card-body">

                        <div class="form-group">
                            <label>Product Category</label>
                            <select>
                                <option>Men's Clothes</option>
                                <option>Women's Clothes</option>
                                <option>Electronics</option>
                                <option>Home & Kitchen</option>
                                <option>Footwear</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label>Product Sub-Category</label>
                            <select>
                                <option>Men's Tops & T-Shirts</option>
                                <option>Shirts</option>
                                <option>Jeans</option>
                                <option>Jackets</option>
                            </select>
                        </div>

                    </div>
                </section>


                <!-- MANAGE STOCK -->
                <section class="card">
                    <div class="card-heading">
                        <h3>Manage Stock</h3>
                    </div>

                    <div class="card-body">

                        <div class="form-group">
                            <label>Stock Keeping Unit</label>
                            <input type="text" value="SKU-BB-66-A6">
                        </div>

                        <div class="form-row">

                            <div class="form-group">
                                <label>Product Stock</label>
                                <input type="number" value="10120">
                            </div>

                            <div class="form-group">
                                <label>Minimum Stock</label>
                                <input type="number" value="100">
                            </div>

                        </div>

                    </div>
                </section>

            </div>


            <!-- RIGHT COLUMN -->
            <div class="form-right">

                <!-- PRODUCT DETAILS -->
                <section class="card">
                    <div class="card-heading">
                        <h3>Product Details</h3>
                    </div>

                    <div class="card-body">

                        <div class="form-row">

                            <div class="form-group">
                                <label>Brand Name</label>
                                <select>
                                    <option>Adidas</option>
                                    <option>Nike</option>
                                    <option>Puma</option>
                                    <option>Reebok</option>
                                </select>
                            </div>

                            <div class="form-group">
                                <label>Product Size</label>
                                <select>
                                    <option>Medium</option>
                                    <option>Small</option>
                                    <option>Large</option>
                                    <option>XL</option>
                                    <option>XXL</option>
                                </select>
                            </div>

                        </div>

                        <div class="form-group">
                            <label>Product Colors</label>
                            <select>
                                <option>Black and White</option>
                                <option>Black</option>
                                <option>White</option>
                                <option>Blue</option>
                                <option>Red</option>
                            </select>
                        </div>

                    </div>
                </section>


                <!-- PRICING -->
                <section class="card">
                    <div class="card-heading">
                        <h3>Product Pricing</h3>
                    </div>

                    <div class="card-body">

                        <div class="form-row">

                            <div class="form-group">
                                <label>Price</label>
                                <div class="price-input">
                                    <span>$</span>
                                    <input type="number" value="12120.00">
                                </div>
                            </div>

                            <div class="form-group">
                                <label>Price</label>
                                <div class="price-input">
                                    <span>$</span>
                                    <input type="number" value="10120.00">
                                </div>
                            </div>

                        </div>

                        <div class="form-row">

                            <div class="form-group">
                                <label>Discount</label>
                                <select>
                                    <option>15%</option>
                                    <option>10%</option>
                                    <option>20%</option>
                                    <option>25%</option>
                                </select>
                            </div>

                            <div class="form-group">
                                <label>Minimum Order</label>
                                <input type="number" value="100">
                            </div>

                        </div>

                    </div>
                </section>


                <!-- PRODUCT IMAGE -->
                <section class="card">
                    <div class="card-heading">
                        <h3>Product Image <span class="info">ⓘ</span></h3>
                    </div>

                    <div class="card-body">

                        <div class="image-gallery">

                            <label class="upload-box">
                                <input type="file" accept="image/*" multiple hidden>
                                <span>♧</span>
                                <p>Click to Upload</p>
                            </label>

                            <div class="image-preview">
                                <img src="https://images.unsplash.com/photo-1521572163474-6864f9cf17ab?w=300" alt="T-shirt">
                                <button type="button" class="remove">Remove</button>
                            </div>

                            <div class="image-preview">
                                <img src="https://images.unsplash.com/photo-1503341504253-dff4815485f1?w=300" alt="T-shirt">
                                <button type="button" class="remove">Remove</button>
                            </div>

                        </div>

                    </div>
                </section>


                <!-- ACTION BUTTONS -->
                <div class="form-actions">

                    <button type="button" class="save-btn">
                        ▣ &nbsp; Save Product
                    </button>

                    <div class="right-actions">
                        <button type="button" class="schedule-btn">
                            ▣ &nbsp; Schedule
                        </button>

                        <button type="submit" class="add-btn">
                            + &nbsp; Add Product
                        </button>
                    </div>

                </div>

            </div>

        </form>