<link rel="stylesheet" href="/css/pro-add.css">

<!-- PAGE TITLE -->
<div class="page-heading">
    <h1>Add New Product</h1>
    <p>Add a new product to your store</p>
</div>

<!-- PRODUCT FORM -->
<form class="product-form" method="post" action="/add" enctype="multipart/form-data">

    <div class="form-left">

        <!-- NAME AND DESCRIPTION -->
        <section class="card">
            <div class="card-heading">
                <h3>Name and Description</h3>
            </div>

            <div class="card-body">

                <div class="form-group">
                    <label>Product Name</label>
                    <input type="text" name="name" required>
                </div>

                <div class="form-group">
                    <label>Product Description</label>
                    <div class="editor">
                        <textarea name="desc" required></textarea>

                        <div class="editor-toolbar">
                            <button type="button"><b>B</b></button>
                            <button type="button"><i>I</i></button>
                            <button type="button"><u>U</u></button>
                            <button type="button">⌁</button>
                            <button type="button">☷</button>
                        </div>
                    </div>
                </div>

            </div>
        </section>

        <!-- CATEGORY -->
        <section class="card">
            <div class="card-heading">
                <h3>Category</h3>
            </div>

            <div class="card-body">

                <div class="form-group">
                    <div class="label-row">
                        <label>Product Category</label>

                        <a href="/form" class="add-category">
                            + Add Category
                        </a>
                    </div>
                    <select name="category" required>

                        <option value="">Select Category</option>

                        <% if (cate && cate.category && cate.category.length> 0) { %>

                            <% cate.category.forEach((item)=> { %>

                                <option value="<%= item.category %>">
                                    <%= item.category %>
                                </option>

                                <% }) %>

                                    <% } else { %>

                                        <option value="">No Data Found</option>

                                        <% } %>

                    </select>
                </div>

                <div class="form-group">
                    <div class="label-row">
                        <label>Product Sub-Category</label>

                        <a href="/form" class="add-category">
                            + Add SubCateg
                        </a>
                    </div>
                   
                    <select name="subCategory" required>

                        <option value="">Select Category</option>

                        <% if (cate && cate.subCategory && cate.subCategory.length> 0) { %>

                            <% cate.subCategory.forEach((item)=> { %>

                                <option value="<%= item.subCategory %>">
                                    <%= item.subCategory %>
                                </option>

                                <% }) %>

                                    <% } else { %>

                                        <option value="">No Data Found</option>

                                        <% } %>

                    </select>
                </div>

            </div>
        </section>

        <!-- MANAGE STOCK -->
        <section class="card">
            <div class="card-heading">
                <h3>Manage Stock</h3>
            </div>

            <div class="card-body">

                <div class="form-group">
                    <label>Stock Keeping Unit</label>
                    <input type="text" name="sku">
                </div>

                <div class="form-row">

                    <div class="form-group">
                        <label>Product Stock</label>
                        <input type="number" name="stock" min="0">
                    </div>

                    <div class="form-group">
                        <label>Minimum Stock</label>
                        <input type="number" name="minStock" min="0">
                    </div>

                </div>

            </div>
        </section>

    </div>

    <!-- RIGHT COLUMN -->
    <div class="form-right">

        <!-- PRODUCT DETAILS -->
        <section class="card">
            <div class="card-heading">
                <h3>Product Details</h3>
            </div>

            <div class="card-body">

                <div class="form-row">

                    <div class="form-group">

                        <div class="label-row">
                        <label>Brand Name</label>

                        <a href="/form" class="add-category">
                            + Add Brand
                        </a>
                    </div>
                        
                        
                        <select name="brand" required>

                            <option value="">Select Category</option>

                            <% if (cate && cate.brand && cate.brand.length> 0) { %>

                                <% cate.brand.forEach((item)=> { %>

                                    <option value="<%= item.brand %>">
                                        <%= item.brand %>
                                    </option>

                                    <% }) %>

                                        <% } else { %>

                                            <option value="">No Data Found</option>

                                            <% } %>

                        </select>
                    </div>

                    <div class="form-group">
                        <div class="form-group">

                        <div class="label-row">
                        <label>Product Size</label>

                        <a href="/form" class="add-category">
                            + Add Size
                        </a>
                    </div>
                       
                        <select name="size" required>

                            <option value="">Select Category</option>

                            <% if (cate && cate.size && cate.size.length> 0) { %>

                                <% cate.size.forEach((item)=> { %>

                                    <option value="<%= item.size %>">
                                        <%= item.size %>
                                    </option>

                                    <% }) %>

                                        <% } else { %>

                                            <option value="">No Data Found</option>

                                            <% } %>

                        </select>
                    </div>

                </div>

                <div class="form-group">
                    <div class="label-row">
                        <label>Product Colors</label>

                        <a href="/form" class="add-category">
                            + Add Color
                        </a>
                    </div>
                    
                    <select name="color" required>

                        <option value="">Select Category</option>

                        <% if (cate && cate.color && cate.color.length> 0) { %>

                            <% cate.color.forEach((item)=> { %>

                                <option value="<%= item.color %>">
                                    <%= item.color %>
                                </option>

                                <% }) %>

                                    <% } else { %>

                                        <option value="">No Data Found</option>

                                        <% } %>

                    </select>
                </div>

            </div>
        </section>

        <!-- PRICING -->
        <section class="card">
            <div class="card-heading">
                <h3>Product Pricing</h3>
            </div>

            <div class="card-body">

                <div class="form-row">

                    <div class="form-group">
                        <label>Price</label>
                        <div class="price-input">
                            <span>$</span>
                            <input type="number" name="price" step="0.01" min="0" required>
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Original Price</label>
                        <div class="price-input">
                            <span>$</span>
                            <input type="number" name="originalPrice" step="0.01" min="0">
                        </div>
                    </div>

                </div>

                <div class="form-row">

                    <div class="form-group">
                         <div class="label-row">
                        <label>Discount</label>

                        <a href="/form" class="add-category">
                            + Add Discount
                        </a>
                    </div>
                        
                        <select name="discount" required>

                            <option value="">Select Category</option>

                            <% if (cate && cate.discount && cate.discount.length> 0) { %>

                                <% cate.discount.forEach((item)=> { %>

                                    <option value="<%= item.discount %>">
                                        <%= item.discount %>
                                    </option>

                                    <% }) %>

                                        <% } else { %>

                                            <option value="">No Data Found</option>

                                            <% } %>

                        </select>
                    </div>

                    <div class="form-group">
                        <label>Minimum Order</label>
                        <input type="number" name="minOrder" min="1">
                    </div>

                </div>

            </div>
        </section>

        <!-- PRODUCT IMAGE -->
        <section class="card">
            <div class="card-heading">
                <h3>Product Image <span class="info">ⓘ</span></h3>
            </div>

            <div class="card-body">

                <div class="image-gallery">

                    <label class="upload-box">
                        <input id="imageFiles" type="file" name="images" accept="image/*" multiple hidden>
                        <span>♧</span>
                        <p>Click to Upload</p>
                    </label>

                </div>

            </div>
        </section>

        <!-- ACTION BUTTONS -->
        <div class="form-actions">



            <div class="right-actions">



                <button type="submit" class="add-btn">
                    + &nbsp; Add Product
                </button>

            </div>
        </div>

    </div>
</form>
<script src="/JS/addForm.js"></script>