<!DOCTYPE html>
<html lang="hi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PDF AI Research</title>
    <link rel="stylesheet" href="/css/styles.css">

   
</head>

<body>
    <div class="app">

        <aside class="sidebar">
            <button class="new-chat" id="newChat">＋ New chat</button>

            <p class="history-title">Recent research</p>

            <div class="history" id="history">
                <div class="history-item">Abhi koi research nahi hai.</div>
            </div>

            <div class="sidebar-bottom">
                <button class="sidebar-button" id="themeButton">
                    ☾ Dark mode
                </button>
                <button class="sidebar-button" id="clearButton">
                    🗑 Clear chat
                </button>
            </div>
        </aside>

        <main class="main">

            <header class="topbar">
                YAGNIK AI Research
            </header>

            <section class="chat-area" id="chatArea">

                <div class="welcome" id="welcome">
                    <div class="logo">✳</div>
                    <h1>What can I help with?</h1>

                    <div class="welcome-grid">
                        <div class="welcome-card">
                            <h3>📄 PDF Research</h3>
                            <p>Multiple PDFs upload karo aur unke content se answers pao.</p>
                        </div>

                        <div class="welcome-card">
                            <h3>🔍 Ask Questions</h3>
                            <p>Documents ke baare mein apna sawaal likho.</p>
                        </div>

                        <div class="welcome-card">
                            <h3>💡 Analyze Documents</h3>
                            <p>Important information, summaries aur comparisons nikalo.</p>
                        </div>
                    </div>
                </div>

                <div class="messages" id="messages"></div>

            </section>

            <section class="input-wrapper">
                <form id="uploadForm" class="composer">

                    <div class="selected-files" id="selectedFiles"></div>

                    <textarea class="question-input" id="question" name="question"
                        placeholder="Apna sawaal likho... jaise: In PDFs ka summary batao" ></textarea>

                    <div class="composer-bottom">

                        <div class="left-actions">
                            <label for="pdfFiles" class="upload-button">
                                ＋ PDF upload
                            </label>

                            <input type="file" id="pdfFiles" name="myFiles" accept=".pdf,application/pdf" multiple>

                            <span class="file-count" id="fileCount">
                                0 PDFs selected
                            </span>
                        </div>

                        <button class="send-button" id="sendButton" type="submit">
                            Send ↑
                        </button>

                    </div>
                </form>

                <p class="status" id="status">
                    PDF upload karo, sawaal likho aur Send dabao.
                </p>

                <p class="footer-note">
                    AI ke answers ko important decisions se pehle verify karein.
                </p>
            </section>

        </main>
    </div>

    <script src="JS/index.js"> </script>

</body>

</html>