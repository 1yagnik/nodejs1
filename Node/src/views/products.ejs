<!DOCTYPE html>
<html lang="hi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PDF AI Research</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            background: #343541;
            color: #ececf1;
            height: 100vh;
            overflow: hidden;
        }

        .app {
            display: flex;
            height: 100vh;
        }

        /* LEFT SIDEBAR */
        .sidebar {
            width: 250px;
            background: #202123;
            padding: 12px;
            display: flex;
            flex-direction: column;
            flex-shrink: 0;
        }

        .new-chat {
            padding: 13px;
            border: 1px solid #565869;
            border-radius: 7px;
            color: white;
            background: transparent;
            text-align: left;
            font-size: 15px;
            cursor: pointer;
        }

        .new-chat:hover,
        .sidebar-button:hover {
            background: #343541;
        }

        .history-title {
            color: #8e8ea0;
            font-size: 12px;
            margin: 25px 8px 12px;
        }

        .history {
            flex: 1;
            overflow-y: auto;
        }

        .history-item {
            padding: 12px 10px;
            border-radius: 6px;
            font-size: 13px;
            overflow-wrap: anywhere;
            cursor: pointer;
        }

        .history-item:hover {
            background: #343541;
        }

        .sidebar-bottom {
            border-top: 1px solid #444654;
            padding-top: 10px;
        }

        .sidebar-button {
            display: block;
            width: 100%;
            padding: 12px 8px;
            color: #ececf1;
            background: transparent;
            border: none;
            text-align: left;
            cursor: pointer;
            border-radius: 6px;
        }

        /* MAIN CHAT AREA */
        .main {
            flex: 1;
            min-width: 0;
            display: flex;
            flex-direction: column;
            position: relative;
        }

        .topbar {
            height: 55px;
            display: flex;
            align-items: center;
            padding: 0 22px;
            border-bottom: 1px solid #444654;
            font-size: 17px;
            font-weight: bold;
        }

        .chat-area {
            flex: 1;
            overflow-y: auto;
            padding: 30px 20px 20px;
        }

        .welcome {
            max-width: 780px;
            margin: 60px auto 35px;
            text-align: center;
        }

        .logo {
            font-size: 35px;
            margin-bottom: 15px;
        }

        .welcome h1 {
            font-size: 30px;
            margin-bottom: 35px;
        }

        .welcome-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 12px;
        }

        .welcome-card {
            background: #444654;
            padding: 18px 12px;
            border-radius: 9px;
        }

        .welcome-card h3 {
            font-size: 15px;
            margin-bottom: 12px;
        }

        .welcome-card p {
            color: #c5c5d2;
            font-size: 13px;
            line-height: 1.6;
        }

        /* UPLOADED FILES */
        .selected-files {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-bottom: 10px;
        }

        .file-chip {
            background: #444654;
            padding: 9px 12px;
            border-radius: 8px;
            font-size: 12px;
            overflow-wrap: anywhere;
        }

        .file-chip button {
            color: #ffaaaa;
            background: transparent;
            border: none;
            margin-left: 8px;
            cursor: pointer;
        }

        /* CHAT MESSAGES */
        .messages {
            max-width: 800px;
            margin: 0 auto;
            width: 100%;
        }

        .message {
            padding: 20px 15px;
            line-height: 1.7;
            white-space: pre-wrap;
            overflow-wrap: anywhere;
        }

        .user-message {
            background: #40414f;
            border-radius: 10px;
            margin-bottom: 15px;
        }

        .ai-message {
            border-bottom: 1px solid #444654;
            margin-bottom: 15px;
        }

        .message-label {
            font-size: 12px;
            color: #a9a9bb;
            margin-bottom: 8px;
            font-weight: bold;
        }

        /* INPUT AREA */
        .input-wrapper {
            padding: 12px 20px 8px;
            background: #343541;
        }

        .composer {
            max-width: 800px;
            margin: 0 auto;
            background: #40414f;
            border: 1px solid #565869;
            border-radius: 14px;
            padding: 12px;
        }

        .question-input {
            width: 100%;
            min-height: 45px;
            max-height: 150px;
            resize: vertical;
            background: transparent;
            color: white;
            border: none;
            outline: none;
            font-size: 15px;
            font-family: inherit;
            padding: 10px 5px;
        }

        .question-input::placeholder {
            color: #a5a5b5;
        }

        .composer-bottom {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            margin-top: 8px;
        }

        .left-actions {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .upload-button {
            display: inline-block;
            background: #343541;
            border: 1px solid #565869;
            color: white;
            padding: 9px 13px;
            border-radius: 8px;
            cursor: pointer;
            font-size: 13px;
        }

        .upload-button:hover {
            background: #565869;
        }

        .file-count {
            color: #a5a5b5;
            font-size: 12px;
        }

        .send-button {
            background: #19a37f;
            color: white;
            border: none;
            padding: 11px 17px;
            border-radius: 8px;
            font-size: 14px;
            cursor: pointer;
        }

        .send-button:hover {
            background: #168b6c;
        }

        .send-button:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        .status {
            max-width: 800px;
            margin: 0 auto;
            padding: 5px 5px 8px;
            font-size: 13px;
            color: #c5c5d2;
        }

        .footer-note {
            text-align: center;
            color: #8e8ea0;
            font-size: 11px;
            padding: 5px 10px 12px;
        }

        #pdfFiles {
            display: none;
        }

        @media (max-width: 650px) {
            .sidebar {
                width: 65px;
                padding: 8px 5px;
            }

            .new-chat {
                text-align: center;
                padding: 12px 3px;
                font-size: 12px;
            }

            .history-title,
            .history,
            .sidebar-bottom .sidebar-button {
                display: none;
            }

            .welcome {
                margin-top: 30px;
            }

            .welcome h1 {
                font-size: 24px;
            }

            .welcome-grid {
                grid-template-columns: 1fr;
            }

            .welcome-card {
                padding: 13px;
            }

            .input-wrapper {
                padding: 8px;
            }

            .topbar {
                padding: 0 12px;
            }
        }
    </style>
</head>

<body>
    <div class="app">

        <aside class="sidebar">
            <button class="new-chat" id="newChat">＋ New chat</button>

            <p class="history-title">Recent research</p>

            <div class="history" id="history">
                <div class="history-item">Abhi koi research nahi hai.</div>
            </div>

            <div class="sidebar-bottom">
                <button class="sidebar-button" id="themeButton">
                    ☾ Dark mode
                </button>
                <button class="sidebar-button" id="clearButton">
                    🗑 Clear chat
                </button>
            </div>
        </aside>

        <main class="main">

            <header class="topbar">
                PDF AI Research
            </header>

            <section class="chat-area" id="chatArea">

                <div class="welcome" id="welcome">
                    <div class="logo">✳</div>
                    <h1>What can I help with?</h1>

                    <div class="welcome-grid">
                        <div class="welcome-card">
                            <h3>📄 PDF Research</h3>
                            <p>Multiple PDFs upload karo aur unke content se answers pao.</p>
                        </div>

                        <div class="welcome-card">
                            <h3>🔍 Ask Questions</h3>
                            <p>Documents ke baare mein apna sawaal likho.</p>
                        </div>

                        <div class="welcome-card">
                            <h3>💡 Analyze Documents</h3>
                            <p>Important information, summaries aur comparisons nikalo.</p>
                        </div>
                    </div>
                </div>

                <div class="messages" id="messages"></div>

            </section>

            <section class="input-wrapper">
                <form id="uploadForm" class="composer">

                    <div class="selected-files" id="selectedFiles"></div>

                    <textarea class="question-input" id="question" name="question"
                        placeholder="Apna sawaal likho... jaise: In PDFs ka summary batao" required></textarea>

                    <div class="composer-bottom">

                        <div class="left-actions">
                            <label for="pdfFiles" class="upload-button">
                                ＋ PDF upload
                            </label>

                            <input type="file" id="pdfFiles" name="myFiles" accept=".pdf,application/pdf" multiple>

                            <span class="file-count" id="fileCount">
                                0 PDFs selected
                            </span>
                        </div>

                        <button class="send-button" id="sendButton" type="submit">
                            Send ↑
                        </button>

                    </div>
                </form>

                <p class="status" id="status">
                    PDF upload karo, sawaal likho aur Send dabao.
                </p>

                <p class="footer-note">
                    AI ke answers ko important decisions se pehle verify karein.
                </p>
            </section>

        </main>
    </div>

    <script>
        const form = document.getElementById("uploadForm");
        const pdfInput = document.getElementById("pdfFiles");
        const questionInput = document.getElementById("question");
        const selectedFiles = document.getElementById("selectedFiles");
        const fileCount = document.getElementById("fileCount");
        const status = document.getElementById("status");
        const sendButton = document.getElementById("sendButton");
        const messages = document.getElementById("messages");
        const welcome = document.getElementById("welcome");
        const chatArea = document.getElementById("chatArea");
        const history = document.getElementById("history");

        let chosenFiles = [];

        // PDF select karne par
        pdfInput.addEventListener("change", () => {
            const newFiles = Array.from(pdfInput.files);

            for (const file of newFiles) {
                if (!chosenFiles.some(
                    existing => existing.name === file.name &&
                        existing.size === file.size
                )) {
                    chosenFiles.push(file);
                }
            }

            if (chosenFiles.length > 5) {
                chosenFiles = chosenFiles.slice(0, 5);
                status.textContent = "Maximum 5 PDFs select kar sakte ho.";
            }

            renderFiles();

            // Same file ko dobara select karne ki permission
            pdfInput.value = "";
        });

        function renderFiles() {
            selectedFiles.replaceChildren();

            chosenFiles.forEach((file, index) => {
                const chip = document.createElement("div");
                chip.className = "file-chip";

                const name = document.createElement("span");
                name.textContent = "📄 " + file.name;

                const remove = document.createElement("button");
                remove.type = "button";
                remove.textContent = "✕";
                remove.title = "Remove PDF";

                remove.addEventListener("click", () => {
                    chosenFiles.splice(index, 1);
                    renderFiles();
                });

                chip.append(name, remove);
                selectedFiles.appendChild(chip);
            });

            fileCount.textContent = chosenFiles.length + " PDFs selected";
        }

        // Form submit: PDF + question backend ko bhejo
        form.addEventListener("submit", async (event) => {
            event.preventDefault();

            const question = questionInput.value.trim();

            if (!question) {
                status.textContent = "Pehle apna sawaal likho.";
                questionInput.focus();
                return;
            }



            const formData = new FormData();

            for (const file of chosenFiles) {
                formData.append("myFiles", file);
            }

            // IMPORTANT: Backend ko sawaal bhi bhej rahe hain
            formData.append("question", question);

            welcome.style.display = "none";

            addMessage("You", question, "user-message");

            status.textContent = "PDF process ho rahi hain. Please wait...";
            sendButton.disabled = true;
            sendButton.textContent = "Working...";

            try {
                const response = await fetch("/", {
                    method: "POST",
                    body: formData
                });

                const data = await response.json();

                if (!response.ok) {
                    throw new Error(data.message || "Request failed");
                }

                status.textContent = data.message || "Research complete.";



                if (Array.isArray(data.results) && data.results.length > 0) {
                    // Multiple PDFs ke answers
                    data.results.forEach((item) => {
                        addMessage(
                            "PDF AI",
                            item.answer || "Koi answer nahi mila.",
                            "ai-message"
                        );
                    });

                } else if (data.answer) {
                    // Single PDF ya normal chat ka answer
                    addMessage(
                        "PDF AI",
                        data.answer,
                        "ai-message"
                    );

                } else {
                    addMessage(
                        "PDF AI",
                        data.message?.content || "Koi answer nahi mila.",
                        "ai-message"
                    );
                }



                const historyItem = document.createElement("div");
                historyItem.className = "history-item";
                historyItem.textContent = question;
                history.prepend(historyItem);

                questionInput.value = "";
                chosenFiles = [];
                renderFiles();

            } catch (error) {
                status.textContent = "Error: " + error.message;

                addMessage(
                    "Error",
                    error.message,
                    "ai-message"
                );
            } finally {
                sendButton.disabled = false;
                sendButton.textContent = "Send ↑";
                chatArea.scrollTop = chatArea.scrollHeight;
            }
        });

        function addMessage(label, text, className) {
            const message = document.createElement("div");
            message.className = "message " + className;

            const heading = document.createElement("div");
            heading.className = "message-label";
            heading.textContent = label;

            const content = document.createElement("div");
            content.textContent = text;

            message.append(heading, content);
            messages.appendChild(message);

            chatArea.scrollTop = chatArea.scrollHeight;
        }

        // New chat
        document.getElementById("newChat").addEventListener("click", () => {
            messages.replaceChildren();
            chosenFiles = [];
            renderFiles();
            questionInput.value = "";
            welcome.style.display = "block";
            status.textContent = "PDF upload karo, sawaal likho aur Send dabao.";
        });

        // Clear chat
        document.getElementById("clearButton").addEventListener("click", () => {
            messages.replaceChildren();
            history.replaceChildren();

            const empty = document.createElement("div");
            empty.className = "history-item";
            empty.textContent = "Abhi koi research nahi hai.";
            history.appendChild(empty);

            welcome.style.display = "block";
        });

        // Dark / light theme toggle
        let darkMode = true;

        document.getElementById("themeButton").addEventListener("click", () => {
            darkMode = !darkMode;

            document.body.style.background = darkMode ? "#343541" : "#f5f5f5";
            document.body.style.color = darkMode ? "#ececf1" : "#222";
            document.querySelector(".main").style.background =
                darkMode ? "#343541" : "#f5f5f5";
            document.querySelector(".sidebar").style.background =
                darkMode ? "#202123" : "#e5e5e5";

            document.getElementById("themeButton").textContent =
                darkMode ? "☾ Dark mode" : "☀ Light mode";
        });
    </script>

</body>

</html>