 <link rel="stylesheet" href="/css/setting.css">
 <header class="page-header">
            <h1>Settings</h1>
        </header>


        <div class="settings-layout">

            <!-- SETTINGS NAVIGATION -->
            <aside class="settings-sidebar">

                <nav>

                    <a href="#" class="active">General</a>
                    <a href="#">Notifications</a>
                    <a href="#">Billing plans</a>
                    <a href="#">Login & security</a>
                    <a href="#">Members</a>
                    <a href="#">User roles</a>

                </nav>

            </aside>


            <!-- SETTINGS DETAILS -->
            <section class="settings-content">

                <!-- PROFILE IMAGE -->
                <div class="profile-section">

                    <div class="profile-image">
                        <img src="https://i.pravatar.cc/200?img=47" alt="Profile">
                    </div>

                    <div class="profile-actions">

                        <button class="delete-button">♜</button>

                        <button class="upload-button">
                            ⇧ Upload
                        </button>

                    </div>

                </div>


                <!-- NAME -->
                <div class="setting-row">

                    <div class="setting-details">
                        <h3>Name</h3>
                        <p>Alex Jackson</p>
                    </div>

                    <button class="edit-button">Edit</button>

                </div>


                <!-- CONTACTS -->
                <div class="setting-row">

                    <div class="setting-details">
                        <h3>Contacts</h3>
                        <p>Phone: +123123217923</p>
                        <p>Email: finalui@yandex.com</p>
                    </div>

                    <button class="edit-button">Edit</button>

                </div>


                <!-- SOCIAL MEDIA -->
                <div class="setting-row">

                    <div class="setting-details">
                        <h3>Social media</h3>
                        <p>linkedin.com/company/finalui</p>
                        <p>dribbble.com/final-ui</p>
                    </div>

                    <button class="edit-button">Edit</button>

                </div>


                <!-- LANGUAGE -->
                <div class="setting-row">

                    <div class="setting-details">
                        <h3>Language & currency</h3>
                        <p>English, USD</p>
                    </div>

                    <button class="edit-button">Edit</button>

                </div>


                <!-- THEME -->
                <div class="setting-row theme-row">

                    <div class="setting-details">
                        <h3>Theme</h3>
                        <p>Appearance</p>
                    </div>

                    <select class="theme-select">
                        <option>Light mode</option>
                        <option>Dark mode</option>
                        <option>System default</option>
                    </select>

                </div>


                <!-- INTEGRATION -->
                <div class="setting-row integration-row">

                    <div class="setting-details">
                        <h3>Integration</h3>
                        <p>Google • examplemail@gmail.com</p>
                    </div>

                    <div class="integration-actions">

                        <span class="connected">
                            ✓ Connected
                        </span>

                        <button class="more-button">•••</button>

                    </div>

                </div>

            </section>

        </div>
