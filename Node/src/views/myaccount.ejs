<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Shopora - My Profile</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, Helvetica, sans-serif;
        }

        body {
            background: #f8f9fb;
            color: #333;
        }

        /* ================= HEADER ================= */

        .main-header {
            width: 100%;
            height: 58px;
            background: #fff;
            display: flex;
            align-items: center;
            padding: 0 20px;
            gap: 25px;
            border-bottom: 1px solid #eee;
        }

        .logo {
            font-size: 25px;
            font-weight: bold;
            color: #174f91;
            text-decoration: none;
            white-space: nowrap;
        }

        .logo span {
            color: #e67e36;
        }

        .search-box {
            width: 320px;
            height: 36px;
            border: 1px solid #e5e5e5;
            border-radius: 6px;
            display: flex;
            align-items: center;
            padding: 0 12px;
        }

        .search-box span {
            color: #999;
            font-size: 17px;
        }

        .search-box input {
            width: 100%;
            border: none;
            outline: none;
            padding-left: 10px;
            font-size: 12px;
        }

        .header-right {
            margin-left: auto;
            display: flex;
            align-items: center;
            gap: 22px;
        }

        .header-right a {
            text-decoration: none;
            color: #555;
            font-size: 12px;
            white-space: nowrap;
        }

        .header-right a span {
            font-size: 16px;
            margin-right: 5px;
        }

        /* ================= CATEGORY NAVBAR ================= */

        .category-navbar {
            width: 100%;
            height: 32px;
            background: #fff;
            border-bottom: 1px solid #eee;
            display: flex;
            align-items: center;
            gap: 28px;
            padding: 0 20px;
            overflow-x: auto;
        }

        .category-navbar a {
            text-decoration: none;
            color: #777;
            font-size: 11px;
            white-space: nowrap;
        }

        .category-navbar a:hover {
            color: #174f91;
        }

        /* ================= MAIN LAYOUT ================= */

        .dashboard-container {
            display: flex;
            min-height: calc(100vh - 90px);
        }

        /* ================= SIDEBAR ================= */

        .sidebar {
            width: 160px;
            min-width: 160px;
            background: #174f91;
            color: white;
            display: flex;
            flex-direction: column;
            min-height: calc(100vh);
        }

        .sidebar-menu {
            display: flex;
            flex-direction: column;
            padding-top: 12px;
        }

        .sidebar-menu a {
            display: flex;
            align-items: center;
            gap: 9px;
            height: 38px;
            padding: 0 15px;
            color: #dce8f7;
            text-decoration: none;
            font-size: 11px;
            white-space: nowrap;
        }

        .sidebar-menu a:hover {
            background: #245fa1;
        }

        .sidebar-menu a.active {
            background: #fff;
            color: #d17b45;
        }

        .sidebar-menu a span {
            font-size: 14px;
            width: 14px;
            text-align: center;
        }

        .sidebar-heading {
            font-size: 10px;
            color: #c6d9ef;
            padding: 15px 15px 5px;
            font-weight: bold;
        }

        .sidebar-heading .arrow {
            float: right;
        }

        /* ================= SIDEBAR USER ================= */

        .sidebar-user {
            margin-top: auto;
            padding: 12px 10px;
            border-top: 1px solid rgba(255, 255, 255, 0.2);
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .sidebar-user img {
            width: 28px;
            height: 28px;
            border-radius: 50%;
            object-fit: cover;
        }

        .sidebar-user-info {
            display: flex;
            flex-direction: column;
            gap: 3px;
        }

        .sidebar-user-info strong {
            font-size: 10px;
            font-weight: 500;
        }

        .sidebar-user-info small {
            font-size: 9px;
            color: #d0e0f4;
        }

        /* ================= MAIN CONTENT ================= */

        .main-content {
            flex: 1;
            padding: 20px 18px;
            min-width: 0;
            max-height: 100vh;
            overflow-y: auto;
        }

        .page-title {
            font-size: 21px;
            font-weight: 600;
            margin-bottom: 24px;
            color: #252c36;
        }

        /* ================= PROFILE CARD ================= */

        .profile-card {
            background: #fff;
            border: 1px solid #e9e9e9;
            border-radius: 9px;
            overflow: hidden;
            max-width: 100%;
        }

        /* ================= PROFILE TABS ================= */

        .profile-tabs {
            display: flex;
            align-items: center;
            gap: 0;
            height: 36px;
            padding: 0 12px;
            border-bottom: 1px solid #eee;
        }

        .profile-tabs a {
            height: 36px;
            padding: 0 15px;
            display: flex;
            align-items: center;
            text-decoration: none;
            color: #555;
            font-size: 11px;
            border-bottom: 2px solid transparent;
        }

        .profile-tabs a.active {
            color: #174f91;
            font-weight: bold;
            border-bottom: 2px solid #174f91;
        }

        /* ================= PROFILE BODY ================= */

        .profile-body {
            padding: 25px 16px 15px;
        }

        /* PROFILE IMAGE */

        .profile-picture-section {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 25px;
        }

        .profile-picture {
            width: 65px;
            height: 65px;
            border-radius: 50%;
            object-fit: cover;
            border: 1px solid #eee;
        }

        .picture-info h4 {
            font-size: 13px;
            margin-bottom: 8px;
        }

        .picture-info p {
            font-size: 11px;
            color: #888;
            margin-bottom: 10px;
        }

        .picture-buttons {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .upload-btn,
        .delete-photo-btn {
            padding: 6px 11px;
            border-radius: 20px;
            font-size: 10px;
            background: #fff;
            cursor: pointer;
        }

        .upload-btn {
            color: #555;
            border: 1px solid #ddd;
        }

        .delete-photo-btn {
            color: #b85c4d;
            border: 1px solid #e8c6c0;
        }

        .upload-btn:hover {
            background: #f5f5f5;
        }

        .delete-photo-btn:hover {
            background: #fff1ef;
        }

        /* ================= PROFILE FORM ================= */

        .profile-form {
            max-width: 490px;
        }

        .form-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 17px 15px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .form-group label {
            font-size: 11px;
            font-weight: 600;
            color: #555;
        }

        .form-group input {
            width: 100%;
            height: 33px;
            border: 1px solid #ddd;
            border-radius: 8px;
            outline: none;
            padding: 0 11px;
            font-size: 11px;
            color: #555;
            background: #fff;
        }

        .form-group input:focus {
            border-color: #174f91;
        }

        .form-group input::placeholder {
            color: #999;
        }

        /* ================= FORM BUTTONS ================= */

        .form-buttons {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-top: 25px;
        }

        .save-btn {
            padding: 7px 13px;
            border: none;
            border-radius: 20px;
            background: #174f91;
            color: #fff;
            font-size: 11px;
            cursor: pointer;
        }

        .cancel-btn {
            padding: 7px 13px;
            border: 1px solid #ddd;
            border-radius: 20px;
            background: #fff;
            color: #555;
            font-size: 11px;
            cursor: pointer;
        }

        .save-btn:hover {
            background: #0e3c72;
        }

        .cancel-btn:hover {
            background: #f5f5f5;
        }

        /* ================= RESPONSIVE ================= */

        @media (max-width: 900px) {

            .header-right {
                gap: 12px;
            }

            .search-box {
                width: 200px;
            }

            .sidebar {
                width: 150px;
                min-width: 150px;
            }

        }

        @media (max-width: 650px) {

            .main-header {
                padding: 10px;
                gap: 12px;
                flex-wrap: wrap;
                height: auto;
            }

            .logo {
                font-size: 22px;
            }

            .search-box {
                flex: 1;
                min-width: 130px;
            }

            .header-right {
                width: 100%;
                justify-content: space-around;
                margin: 5px 0;
            }

            .category-navbar {
                gap: 20px;
            }

            .dashboard-container {
                flex-direction: column;
            }

            .sidebar {
                width: 100%;
                min-width: 100%;
                min-height: auto;
            }

            .sidebar-menu {
                padding: 5px 0;
            }

            .sidebar-heading,
            .sidebar-user {
                display: none;
            }

            .sidebar-menu a {
                height: 35px;
            }

            .main-content {
                padding: 18px 12px;
            }

            .page-title {
                margin-bottom: 15px;
            }

            .profile-body {
                padding: 20px 12px;
            }

        }

        @media (max-width: 420px) {

            .form-grid {
                grid-template-columns: 1fr;
            }

            .profile-tabs a {
                padding: 0 9px;
                font-size: 10px;
            }

            .profile-picture {
                width: 55px;
                height: 55px;
            }

            .picture-info p {
                font-size: 10px;
            }

        }
    </style>

</head>

