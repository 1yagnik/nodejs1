<link rel="stylesheet" href="/css/customer.css">
<header class="topbar">

            <div class="top-search">
                <span>⌕</span>
                <input type="text" placeholder="Search here...">
            </div>

            <div class="top-right">

                <button class="top-button">✉</button>

                <button class="top-button notification">
                    ♧
                    <span></span>
                </button>

                <div class="profile">

                    <img src="https://i.pravatar.cc/100?img=12" alt="Profile">

                    <div>
                        <strong>Beau Alexander</strong>
                        <small>alexander@gmail.com</small>
                    </div>

                    <span class="dropdown">⌄</span>

                </div>

            </div>

        </header>


        <!-- PAGE HEADING -->
        <div class="page-heading">

            <h1>Customer</h1>

            <button class="add-customer">
                <span>+</span> Add New Customer
            </button>

        </div>


        <!-- CUSTOMER CARD -->
        <section class="customer-card">

            <!-- CARD HEADER -->
            <div class="card-header">

                <h3>Customer List</h3>

                <div class="table-search">
                    <span>⌕</span>
                    <input type="text" placeholder="Search here...">
                </div>

                <div class="header-actions">

                    <button class="filter-button">
                        ☰ &nbsp; Filter
                    </button>

                    <button class="expand-button">↗</button>

                </div>

            </div>


            <!-- TABLE -->
            <div class="table-container">

                <table>

                    <thead>
                        <tr>
                            <th class="check-column">
                                <input type="checkbox">
                            </th>
                            <th>Name</th>
                            <th>E-mail</th>
                            <th>Phone</th>
                            <th>Location</th>
                            <th>Gender</th>
                            <th>Action</th>
                        </tr>
                    </thead>

                    <tbody>
                        <% if (customers &&  customers.length> 0) { %>
                            <% customers.forEach((customer, index)=> { %>

                        <tr>
                            <td><input type="checkbox"></td>
                            <td>
                                <div class="customer-name">
                                    <img src="https://i.pravatar.cc/100?img=47">
                                    Isabella Taylor
                                </div>
                            </td>
                            <td><%= customer.email %></td>
                            <td>+1901 234 5678</td>
                            <td>Cape, South Africa</td>
                            <td>Female</td>
                            <td class="action">•••</td>
                        </tr>
                        <% }); %>

                                <% } else { %>

                                    <p>Your cart is empty.</p>
                        <% } %>

                 

                    </tbody>

                </table>

            </div>

        </section>